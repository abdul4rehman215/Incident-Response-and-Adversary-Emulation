# ==============================================================
# LAB 05 — Basic Custom Detection Rules
# Author: Lab Student
# Purpose: Simulated attack detection rules
# ==============================================================

# --------------------------------------------------------------
# 1. Detect ICMP Ping Activity
# --------------------------------------------------------------
alert icmp any any -> $HOME_NET any \
(msg:"ICMP Ping Detected"; \
sid:1000001; rev:1;)

# --------------------------------------------------------------
# 2. Detect Suspicious HTTP Request (malware keyword in URI)
# --------------------------------------------------------------
alert http any any -> any any \
(msg:"Suspicious HTTP Request"; \
content:"malware"; http_uri; \
sid:1000002; rev:1;)

# --------------------------------------------------------------
# 3. Detect SSH Brute Force Attempts
# Triggers after 5 SYN packets within 60 seconds
# --------------------------------------------------------------
alert tcp any any -> $HOME_NET 22 \
(msg:"Potential SSH Brute Force"; \
flags:S; \
threshold:type both, track by_src, count 5, seconds 60; \
sid:1000003; rev:1;)

# --------------------------------------------------------------
# 4. Detect Suspicious DNS Queries
# --------------------------------------------------------------
alert dns any any -> any any \
(msg:"Suspicious DNS Query"; \
dns_query; content:"malicious"; \
sid:1000004; rev:1;)

# --------------------------------------------------------------
# 5. Detect Large File Downloads (>1MB)
# --------------------------------------------------------------
alert http any any -> any any \
(msg:"Large File Download"; \
filesize:>1000000; \
sid:1000005; rev:1;)
